PORT=5000
# Local: mongodb://127.0.0.1:27017/intern_auto  (run: docker compose up -d)
# Deploy: mongodb+srv://USER:PASS@cluster....mongodb.net/intern_auto?retryWrites=true&w=majority
MONGODB_URI=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Must match the frontend's NEXTAUTH_SECRET exactly — the backend verifies
# the bearer token the frontend mints from the same secret (see backend/middleware/auth.js)
NEXTAUTH_SECRET=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
RENDER_EXTERNAL_URL=
# Aptitude question bank refresh (cron runs while backend is up)
APTITUDE_REFRESH_ENABLED=true
APTITUDE_REFRESH_CRON=0 3 * * 0
APTITUDE_REFRESH_PER_CATEGORY=5
APTITUDE_MAX_BANK_SIZE=300
